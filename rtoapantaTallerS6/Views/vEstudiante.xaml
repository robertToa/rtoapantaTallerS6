<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="rtoapantaTallerS6.vEstudiante"
             Title="vEstudiante">
    <VerticalStackLayout>
        <Label 
            Text="SEMANA 6:CRUD ESTUDIANTES"
            VerticalOptions="Center" 
            FontSize="20"
            HorizontalOptions="Center" />
        <ListView
            x:Name="lvEstudiantes"
            Margin="20"
            HasUnevenRows="True"
            ItemSelected="lvEstudiantes_ItemSelected">
            <ListView.Header>
                <Grid Padding="10"
                      ColumnDefinitions="50,100,100,50"
                      BackgroundColor="LightBlue">
                    <Label Text="Código"
                           FontAttributes="Bold"
                           Grid.Column="0"/>
                    <Label Text="Nombre"
                           FontAttributes="Bold"
                           Grid.Column="1"/>
                    <Label Text="Apellido"
                           FontAttributes="Bold"
                           Grid.Column="2"/>
                    <Label Text="Edad"
                           FontAttributes="Bold"
                           Grid.Column="3"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="{Binding codigo}" FontSize="16" WidthRequest="50"/>
                            <Label Text="{Binding nombre}" FontSize="16" WidthRequest="100"/>
                            <Label Text="{Binding apellido}" FontSize="16" WidthRequest="100"/>
                            <Label Text="{Binding edad}" FontSize="16" WidthRequest="50"/>
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>